# LaunchPad v2.1 plugin runtime + Layer 3 lint dependencies (human-edited source).
#
# This file lists DIRECT top-level dependencies only. Transitive dependencies
# + sha256 hashes are resolved by `pip-compile --generate-hashes` and written
# to `requirements.txt` (the auto-generated lock file used by CI + lefthook).
#
# Workflow:
#   1. Edit this file (bump versions, add/remove direct deps)
#   2. Run `make lock-deps` to regenerate requirements.txt
#   3. Commit BOTH files together
#
# THIS FILE IS AUTHORITATIVE for every version below. Do NOT sync versions
# FROM `_vendor/*_VERSION`.
#
# `_vendor/` holds pin files for the four deps with a second on-disk source of
# truth: PSUTIL_VERSION + PYYAML_VERSION (read by plugin-v2-handshake-lint.py)
# and JINJA2_VERSION + MARKUPSAFE_VERSION (record which version is vendored
# under plugin_stack_adapters/_vendor/). Those four must move together with
# this file. Nothing else belongs there.
#
# Historical note (2026-07-31): pin files also existed for ruff/pyright/bandit/
# semgrep/pytest. Nothing read them, nothing kept them current, and an earlier
# instruction here told maintainers to keep this file "in lockstep" with them —
# which, because they were years stale, silently downgraded lint and security
# tooling for anyone who complied. They were deleted in v2.1.11 (PR #138).

# --- v2.0 runtime deps ---

psutil==7.2.2          # /lp-scaffold-stack runtime (pid_identity)
pyyaml==6.0.3          # config loading (engine.py, plugin-v2-handshake-lint.py)
jinja2==3.1.6          # /lp-bootstrap + /lp-scaffold-stack template rendering
markupsafe==3.0.3      # transitive of jinja2; pinned explicitly for repro

# --- v2.1.1 Phase 4 Layer 3 static analysis ---

ruff==0.16.0           # style + import-order + bugbear (lefthook pre-commit)
# pyright pulls nodeenv, which downloads a Node.js binary at install-time.
# That binary download is OUTSIDE pip's hash coverage — a residual supply-chain
# hole at the pyright/nodeenv boundary. v2.1.x BL candidate: evaluate mypy (no
# Node dep) OR pin the node binary download via CI checksum verification.
pyright==1.1.411       # type-check (lefthook pre-push, strict on 5 contract modules)
bandit==1.9.4          # security audit at MEDIUM+ (lefthook pre-commit)
# NOTE: semgrep hard-pins `mcp==1.23.3` (exact `==`, still true at 1.171.0),
# which blocks the fixes for three MCP server-side advisories (GHSA-hvrp,
# GHSA-jpw9 -> mcp 1.27.2; GHSA-vj7q -> mcp 1.28.1). Suppressed with
# rationale + expiry in osv-scanner.toml (this directory). Whoever bumps
# semgrep past that pin: re-lock so mcp moves to >=1.28.1, then delete the
# suppression entries. (The earlier click~=8.1.8 pin cleared at semgrep
# 1.171.0 -- click is now 8.4.2 and its suppression has been removed.)
semgrep==1.171.0       # general patterns (pre-commit) + LP-internal invariants (pre-push)
pytest==9.1.1          # test runner (lefthook pre-push + CI v2-handshake-lint); pinned for hash coverage (Codex PR #62 P1 #2)
