{
  "schema_version": 1,
  "protocol_id": "launchpad-codex-adapter",
  "protocol_version": "1.0.0",
  "name_pattern": "^[a-z0-9][a-z0-9-]*$",
  "stack_scope_pattern": "^(core_pipeline|stack:any|stack:[a-z_]{1,32}|design_quality|skill_quality)$",
  "metadata_namespace": "x-launchpad",
  "component_kinds": ["command", "skill", "agent"],
  "project_extension_roster_fields": [
    "review_agents",
    "review_db_agents",
    "review_design_agents",
    "review_copy_agents",
    "harden_plan_agents",
    "harden_plan_conditional_agents",
    "harden_document_agents",
    "protected_branches"
  ],
  "canonical_dialect": {
    "nested_command": {
      "source_construct": "/lp-<name>",
      "typed_operation": "invoke_command",
      "required_capability": "nested_command"
    },
    "plugin_root": {
      "source_construct": "${CLAUDE_PLUGIN_ROOT}",
      "typed_operation": "bind_installed_plugin_root",
      "required_capability": "installed_root_binding"
    },
    "skill_or_resource_load": {
      "source_construct": "declared skill, reference, asset, or script load",
      "typed_operation": "read_declared_resource",
      "required_capability": "canonical_resource_read"
    },
    "subagent_dispatch": {
      "source_construct": "Task or subagent dispatch",
      "typed_operation": "dispatch_declared_agent",
      "required_capability": "generic_subagents"
    },
    "interaction_request": {
      "source_construct": "interactive user request",
      "typed_operation": "request_authenticated_interaction",
      "required_capability": "authenticated_user_interaction"
    },
    "tool_capability": {
      "source_construct": "declared tool-name capability",
      "typed_operation": "invoke_permitted_tool",
      "required_capability": "operation_authorization"
    },
    "claude_hook": {
      "source_construct": "Claude-only hook statement",
      "typed_operation": "require_host_hook",
      "required_capability": "host_hooks"
    },
    "claude_presentation": {
      "source_construct": "Claude-only presentation statement",
      "typed_operation": "present_bounded_result",
      "required_capability": "host_presentation"
    }
  },
  "router": {
    "entry_skill": "lp",
    "command_prefix": "lp-",
    "reserved_tokens": ["help", "lp", "skill"],
    "zero_mutation_required_capabilities": [
      "detached_digest_attestation",
      "explicit_invocation_provenance",
      "first_executable_verification",
      "prompt_free_shell_deny",
      "serialized_payload_mediation",
      "structured_arguments"
    ]
  },
  "metadata_schema": {
    "top_level_fields": [
      "name",
      "description",
      "user-invocable",
      "tools",
      "model",
      "color",
      "stack_scope",
      "argument-hint",
      "disable-model-invocation",
      "allowed-tools",
      "context",
      "agent",
      "hooks",
      "x-launchpad"
    ],
    "namespace_fields": [
      "schema-version",
      "component-kind",
      "direct",
      "capabilities",
      "bounded-loop"
    ],
    "required_namespace_fields": ["schema-version", "component-kind", "capabilities"],
    "direct_edge_fields": [
      "commands",
      "skills",
      "agents",
      "references",
      "assets",
      "scripts",
      "external-tools"
    ],
    "capability_fields": [
      "required",
      "mutation",
      "interaction",
      "external-data-egress",
      "write-scopes",
      "tool-profile",
      "fallback"
    ],
    "bounded_loop_fields": ["max-iterations", "reentry-command"]
  },
  "capability_ids": [
    "canonical_resource_read",
    "installed_root_binding",
    "structured_arguments",
    "explicit_invocation_provenance",
    "interaction_mode_attestation",
    "authenticated_user_interaction",
    "detached_digest_attestation",
    "first_executable_verification",
    "repository_read",
    "repository_write",
    "shell_execution",
    "prompt_free_shell_deny",
    "network_egress",
    "serialized_payload_mediation",
    "nested_command",
    "generic_subagents",
    "subagent_cancel_final_join",
    "operation_authorization",
    "persistent_instruction_write",
    "project_prompt_admission",
    "plugin_durable_state",
    "atomic_receipt_reservation",
    "authoritative_budget_enforcement",
    "effect_revocation_status",
    "external_cli",
    "browser",
    "mcp_server",
    "connector",
    "host_hooks",
    "host_presentation"
  ],
  "classes": {
    "mutation": [
      "none",
      "project_files",
      "repository_state",
      "external_state",
      "project_and_external"
    ],
    "interaction": ["none", "optional", "required", "authenticated_approval"],
    "base_support_state": ["supported", "blocked"],
    "applicability": ["applicable", "not_applicable"],
    "effective_availability": ["available", "blocked"],
    "release_stage": ["dogfood", "beta", "stable"],
    "lifecycle_stage": ["inventory", "test_candidate", "release"],
    "reporting": ["public_bug", "private_security"],
    "fallback": ["inspect_only", "read_only_manual", "none"],
    "tool_profile": ["inspect_only", "read_only", "workspace_write", "effectful"],
    "resource_origin": ["built_in", "project"],
    "admission_source": ["interactive", "headless"],
    "project_selection_source": ["roster", "canonical_reference"],
    "run_state": [
      "created",
      "preflight_passed",
      "approved",
      "receipt_ready",
      "effect_active",
      "terminal"
    ],
    "approval_state": ["pending", "approved", "declined", "expired"],
    "approval_kind": ["effect", "persistent_instruction_write"],
    "mutation_state": ["not_started", "committed", "partial"],
    "terminal_state": ["succeeded", "blocked", "declined", "failed", "partial"],
    "gate_result": ["pass", "blocked"],
    "log_status": ["checked", "allowed", "blocked", "started", "committed", "partial", "failed"],
    "effect_kind": ["ai_child", "product_mutation", "external_effect"],
    "egress_transport": [
      "host_provider",
      "subagent",
      "browser",
      "mcp",
      "connector",
      "cli",
      "subprocess"
    ],
    "evidence_status": ["current", "expired", "revoked"]
  },
  "cli_schema_spelling": {
    "inventory": "inventory",
    "test-candidate": "test_candidate",
    "generate": "release"
  },
  "digest_domains": {
    "runtime_payload_digest": {
      "algorithm": "sha256",
      "excludes": [
        "codex/support-evidence.json",
        "generated_documentation",
        "detached_distribution_descriptors"
      ]
    },
    "evidence_digest": {
      "algorithm": "sha256",
      "covers": ["codex/support-evidence.json"]
    },
    "artifact_digest": {
      "algorithm": "sha256",
      "covers": ["completed_plugin_package"],
      "storage": "detached_attestation_only"
    }
  },
  "packaging": {
    "manifest_shared_fields": [
      "author",
      "description",
      "homepage",
      "keywords",
      "license",
      "name",
      "repository",
      "version"
    ],
    "manifest_host_fields": {
      "skills": "./codex/skills/"
    },
    "runtime_helpers": [
      "codex/adapter-protocol.json",
      "codex/skills/lp/SKILL.md",
      "scripts/plugin-codex-manifest.py",
      "scripts/plugin-codex-protocol.py",
      "scripts/plugin-codex-resolver.py",
      "scripts/plugin-codex-router.py",
      "scripts/plugin-codex-support.py"
    ],
    "generated_slots": ["README.md", "codex/support-evidence.json", "docs/guides/HOW_IT_WORKS.md"],
    "documentation_regions": {
      "README.md": "codex-beta-summary",
      "docs/guides/HOW_IT_WORKS.md": "codex-support-matrix"
    }
  },
